DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Priority: MySQL > Postgres > SQLite (first configured wins) ---

# Fill these in to use a local MySQL or MariaDB server:
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=smartspend
MYSQL_USER=smartspend_user
MYSQL_PASSWORD=
# Optional: Unix socket for local socket connections instead of TCP
# MYSQL_UNIX_SOCKET=/var/run/mysqld/mysqld.sock

# Leave POSTGRES_HOST unset to use SQLite or MySQL above.
# Fill these in to point at your Supabase Postgres instance:
POSTGRES_HOST=
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
